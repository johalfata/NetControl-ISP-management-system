# =============================================================================
# NetControl - Contoh konfigurasi environment (PLACEHOLDER ONLY)
# Salin menjadi .env lalu isi nilai sebenarnya. JANGAN commit file .env.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://netcontrol:CHANGE_ME@127.0.0.1:5432/netcontrol?schema=public"

# --- Aplikasi ----------------------------------------------------------------
# Port aplikasi (dev & start script memakai 4755)
PORT=4755
# URL publik aplikasi, dipakai untuk link di dalam notifikasi & webhook
APP_URL="http://localhost:4755"
NODE_ENV=production

# --- Kunci kriptografi -------------------------------------------------------
# WAJIB. Kunci enkripsi kredensial integrasi (RouterOS, Fonnte, dll).
# 32 byte acak, format base64.  Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JANGAN simpan kunci ini di dalam database. Kehilangan kunci = kredensial
# tersimpan tidak dapat didekripsi.
ENCRYPTION_KEY="GANTI_DENGAN_32_BYTE_BASE64"

# Rahasia HMAC untuk autentikasi webhook n8n (dan signature notifikasi).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_HMAC_SECRET="GANTI_DENGAN_RAHASIA_HEX"

# --- Provisioning owner awal -------------------------------------------------
# Dipakai HANYA oleh `npm run db:seed` untuk membuat akun owner pertama.
# Tidak ada password default di produksi; seed menolak jalan tanpa nilai ini.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="GANTI_DENGAN_PASSWORD_KUAT"
SEED_OWNER_NAME="Owner"

# --- Job runner --------------------------------------------------------------
# Token untuk memicu endpoint job terjadwal secara eksternal (n8n/cron).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_RUNNER_TOKEN="GANTI_DENGAN_TOKEN_JOB"

# --- Opsional ----------------------------------------------------------------
# Batas jumlah login gagal sebelum akun terkunci sementara (menit).
AUTH_LOCKOUT_MINUTES=15
# Retensi default telemetri (hari). Dapat diubah dari UI Settings.
METRICS_RETENTION_DAYS=90